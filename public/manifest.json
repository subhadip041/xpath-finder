{
  "manifest_version": 3,
  "name": "XPath Capture & Verify",
  "version": "1.0",
  "description": "Click to capture or verify XPath on any webpage.",
  "permissions": ["scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "index.html"
 
  }
}
